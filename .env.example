# Backend (pydantic-settings reads .env; unknown entries are ignored)
GCS_BUCKET_NAME=motavi-videos
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Auth (JWT). JWT_SECRET signs sign-in, upload links and frame links (at least 32 bytes);
# SETUP_KEY guards /auth/register, leave empty when no account is being created.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
SETUP_KEY=

# Upload links point here
PUBLIC_APP_URL=http://localhost:5173

# All variables: docs/BETRIEB.md

# Frontend dev proxy target (used by frontend/vite.config.ts)
VITE_API_BASE_URL=http://localhost:8000
