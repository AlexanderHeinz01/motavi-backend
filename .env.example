# Google Cloud Storage
GCS_BUCKET_NAME=motavi-videos
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Auth (JWT). JWT_SECRET signs access tokens; SETUP_KEY guards /auth/register.
JWT_SECRET=change-me-to-a-long-random-string
SETUP_KEY=another-long-random-bootstrap-key

# Frontend dev proxy target (used by vite.config.ts)
VITE_API_BASE_URL=http://localhost:8000
